<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="praaaaa13.Views.MainPage"
    Title="Список товаров">

    <StackLayout>
        <ListView x:Name="lvProducts"
                  HasUnevenRows="True"
                  ItemTapped="OnItemTapped">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Padding="10">
                            <Label Text="{Binding Name}" FontSize="16" TextColor="Black"/>
                            <Label Text="{Binding Category}" FontSize="14" TextColor="Gray"/>
                            <Label Text="{Binding Manufacturer}" FontSize="14" TextColor="Gray"/>
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Text="Добавить товар"
                Clicked="OnAddClicked"
                Margin="10"/>
    </StackLayout>

</ContentPage>
